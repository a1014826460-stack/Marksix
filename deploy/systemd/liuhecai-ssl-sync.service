[Unit]
Description=Liuhecai: renew and sync nginx TLS certificates
Documentation=file:///root/Marksix/scripts/sync-nginx-certs.sh
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/Marksix
# 按节点覆盖：中心节点用 docker-compose.yml，前端节点用 docker-compose.frontend-node.yml。
Environment=LIUHECAI_REPO=/root/Marksix
Environment=LIUHECAI_COMPOSE_FILE=docker-compose.yml
Environment=LIUHECAI_NGINX_SERVICE=nginx
ExecStart=/root/Marksix/scripts/sync-nginx-certs.sh
# 失败的可见性：systemd 记录非零退出，日志同时写入 /var/log/liuhecai-ssl-sync.log
TimeoutStartSec=900
