[Unit]
Description=Liuhecai: daily TLS certificate renew/sync/verify

[Timer]
# 每天 04:20 北京时间执行。两台服务器的系统时区是 UTC，因此必须显式写时区，
# 否则 04:20 会落在 12:20 北京时间，与 daily_prediction（12:00 北京）撞车。
# 04:20 北京同时避开 21:30-22:40 的开奖窗口。
OnCalendar=*-*-* 04:20:00 Asia/Hong_Kong
# 机器维护/关机错过时开机后补跑一次。
Persistent=true
RandomizedDelaySec=300
Unit=liuhecai-ssl-sync.service

[Install]
WantedBy=timers.target
