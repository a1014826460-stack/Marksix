# ============================================================
# Liuhecai environment template
# Copy this file to `.env` and edit the real values.
# ============================================================

# PostgreSQL password (change in production)
POSTGRES_PASSWORD=change_me_in_production

# Site ID
LOTTERY_SITE_ID=1

# Nginx config source
# Production should point this to a local file, for example:
# NGINX_CONF_SOURCE=./deploy/nginx.conf.local
NGINX_CONF_SOURCE=./deploy/nginx.conf

# Set to 1 to force HTTPS validation in deploy scripts
NGINX_EXPECT_HTTPS=0
