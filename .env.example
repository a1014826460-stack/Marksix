# ============================================================
# Liuhecai production Docker Compose environment template
# Copy to root `.env` only on the production server.
# Windows development uses ignored backend/.env.local instead.
# ============================================================

# This root file is production-only. Do not add DATABASE_URL here: Compose
# injects the internal pgbouncer:6432 target into backend containers.
LIUHECAI_RUNTIME_ENV=production

# PostgreSQL 密码（生产环境必须通过部署 Secret 注入，不要提交真实值）
POSTGRES_PASSWORD=replace_with_a_deployment_secret

# DATABASE_URL is intentionally forbidden in this file.

# Optional FRP client token. Keep the real value outside the repository.
# FRP_AUTH_TOKEN=replace_with_a_deployment_secret

# Python API 进程内 PostgreSQL 连接池
# 6 个站点共用同一后端时，建议先保守预留更高上限，再结合实际流量下调。
POSTGRES_POOL_MAX_SIZE=120
POSTGRES_POOL_TIMEOUT=15

# PgBouncer 连接池
PGBOUNCER_MAX_CLIENT_CONN=1200
PGBOUNCER_DEFAULT_POOL_SIZE=50

# 默认站点 ID
LOTTERY_SITE_ID=1

# 中心后端（仅供 docker-compose.frontend-node.yml 使用）。非中心前端节点
# 通过 www.tw8800.com 读取统一数据，不部署 PostgreSQL、Python API 或调度器。
LOTTERY_BACKEND_BASE_URL=https://www.tw8800.com/central-api/api
LOTTERY_UPLOADS_BASE_URL=https://www.tw8800.com/central-api/uploads

# Nginx 配置来源
# 如果启用域名 + HTTPS，通常应改为：
# NGINX_CONF_SOURCE=./deploy/nginx.conf.local
NGINX_CONF_SOURCE=./deploy/nginx.conf

# 对外访问主机，用于 deploy/verify.sh 验证
# 无域名模式示例：
#   PUBLIC_HOST=localhost
#   PUBLIC_SCHEME=http
# 域名 + HTTPS 模式示例：
#   PUBLIC_HOST=www.example.com
#   PUBLIC_SCHEME=https
PUBLIC_HOST=localhost
PUBLIC_SCHEME=http

# 是否要求按 HTTPS 模式验证
# 0 = HTTP / IP / 无域名
# 1 = HTTPS / 正式域名
NGINX_EXPECT_HTTPS=0

# Optional build mirrors for regions with unstable access to the default upstreams.
# Example:
# NPM_REGISTRY=https://registry.npmmirror.com/
# APT_MIRROR=mirrors.aliyun.com
NPM_REGISTRY=https://registry.npmjs.org/
APT_MIRROR=deb.debian.org
