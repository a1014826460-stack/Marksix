# ============================================================
# Liuhecai 环境变量模板
# 复制为 `.env` 后再填写真实值
# ============================================================

# PostgreSQL 密码（生产环境必须修改）
POSTGRES_PASSWORD=change_me_in_production

# 默认站点 ID
LOTTERY_SITE_ID=1

# Nginx 配置来源
# 如果启用域名 + HTTPS，通常应改为：
# NGINX_CONF_SOURCE=./deploy/nginx.conf.local
NGINX_CONF_SOURCE=./deploy/nginx.conf

# 对外访问主机，用于 deploy/verify.sh 验证
# 无域名模式示例：
#   PUBLIC_HOST=localhost
#   PUBLIC_SCHEME=http
# 域名 + HTTPS 模式示例：
#   PUBLIC_HOST=www.example.com
#   PUBLIC_SCHEME=https
PUBLIC_HOST=localhost
PUBLIC_SCHEME=http

# 是否要求按 HTTPS 模式验证
# 0 = HTTP / IP / 无域名
# 1 = HTTPS / 正式域名
NGINX_EXPECT_HTTPS=0
