# Frontend-only deployment environment. Copy this file to .env on every
# non-central site server and do not add PostgreSQL or Python API settings.
LOTTERY_BACKEND_BASE_URL=https://www.tw8800.com/central-api/api
LOTTERY_UPLOADS_BASE_URL=https://www.tw8800.com/central-api/uploads
LOTTERY_SITE_ID=9

NGINX_CONF_SOURCE=./deploy/nginx.frontend-node.conf
PUBLIC_HOST=www.example.com
PUBLIC_SCHEME=http
NGINX_EXPECT_HTTPS=0

NPM_REGISTRY=https://registry.npmjs.org/
